# Copy to .env locally or configure these in your host's secret manager.
DB_USERNAME=linkedin_app
DB_PASSWORD=
DB_ADMIN_PASSWORD=
JWT_SECRET=
# Exactly 32 UTF-8 bytes. Keep the previous effective key for encrypted legacy data.
ENCRYPTION_KEY=
# Temporary explicit compatibility for legacy AES values; migrate before enabling normal use.
ALLOW_LEGACY_ENCRYPTION_KEY=false
DEEPSEEK_API_KEY=
# NanoGPT for images generated by the Spring Boot backend (keep this server-side).
# GitHub Actions uses the repository/environment secret NANOGPT_KEY separately.
NANOGPT_API_KEY=
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
# manual: local editor + exported Actions queue; actions: remote backend; quartz: remote scheduler.
SCHEDULER_MODE=manual
# At least 32 random characters. Identical secret in the backend and GitHub environment.
AUTOMATION_TOKEN=
AUTOMATION_TENANT_ID=
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# LinkedIn OAuth (app settings; never expose these in Angular or GitHub Actions)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must match exactly the HTTPS callback registered in LinkedIn Developer Portal.
LINKEDIN_OAUTH_REDIRECT_URI=https://localhost:8443/api/v1/credentials/linkedin/oauth/callback
FRONTEND_BASE_URL=http://localhost:4200
LINKEDIN_OAUTH_SECURE_COOKIE=true
# Add the UI origin when it differs from localhost:4200.
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
