# AutoPost: plantilla única de configuración local.
# Copia este archivo como .env en la raíz. No rellenes ni subas claves reales aquí.
# Docker Compose y Spring Boot leen este archivo desde la raíz del repositorio.

# 1. Base de datos
# Para backend local con docker-compose.yml, DB_URL apunta al puerto publicado por PostgreSQL.
# En Docker de producción, DB_URL se reemplaza por la dirección interna del contenedor.
DB_URL=jdbc:postgresql://localhost:5433/linkedin_automation
# Desarrollo: si dejas estos campos vacíos, Spring usa postgres/postgres como en docker-compose.yml.
# Producción: usuario de aplicación separado del administrador.
DB_USERNAME=
DB_PASSWORD=
DB_ADMIN_PASSWORD=

# 2. Sesiones y cifrado
# Genera JWT_SECRET aleatorio (por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))").
JWT_SECRET=
# Exactamente 32 bytes UTF-8. Debe mantenerse estable para descifrar claves ya guardadas.
# Puedes generar 32 caracteres ASCII con: python -c "import secrets; print(secrets.token_hex(16))"
ENCRYPTION_KEY=
# Mantener false salvo migración deliberada de credenciales cifradas antiguas.
ALLOW_LEGACY_ENCRYPTION_KEY=false
# En local HTTP puedes usar false. En producción HTTPS debe ser true.
SESSION_COOKIE_SECURE=false

# 3. IA para texto (DeepSeek)
# DEEPSEEK_API_KEY es la clave global de respaldo para espacios sin clave propia.
# También puedes dejarla vacía y configurar una clave por espacio en Ajustes > Proveedores de IA.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 4. Generación de imágenes y visión
# Clave global de respaldo de NanoGPT; los usuarios también pueden guardar la suya en Ajustes.
NANOGPT_API_KEY=
# Solo afecta modelos Nano Banana que acepten resolución (por ejemplo 1k o 2k).
NANOGPT_IMAGE_RESOLUTION=
# Opcional: imágenes de respaldo de Pexels.
PEXELS_API_KEY=
# Opcional: modelo compatible para analizar imágenes que adjunta el usuario.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# 5. LinkedIn OAuth de la aplicación
# Se obtienen al registrar AutoPost en LinkedIn Developers; nunca son claves de cada usuario.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Debe coincidir exactamente con la URL registrada en LinkedIn Developers.
LINKEDIN_OAUTH_REDIRECT_URI=https://localhost:8443/api/v1/credentials/linkedin/oauth/callback
LINKEDIN_OAUTH_SECURE_COOKIE=true
LINKEDIN_API_BASE_URL=https://api.linkedin.com
LINKEDIN_API_VERSION=202607

# 6. URL pública, navegador y acceso
# Para desarrollo local; en producción reemplazar por el dominio HTTPS de AutoPost.
FRONTEND_BASE_URL=http://localhost:4200
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Déjalo vacío si no has configurado un usuario administrador inicial.
AUTOPOST_ADMIN_EMAILS=
# Local: false. Producción detrás del proxy configurado: true solo si el proxy sanea X-Forwarded-For.
RATE_LIMIT_TRUST_FORWARDED_FOR=false

# 7. Publicación y correo
# Local: manual para que Quartz no publique. En producción configura quartz cuando quieras activar horarios.
SCHEDULER_MODE=manual
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
