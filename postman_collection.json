    {
      "name": "04 - Publications & Swipe Studio (CRUD y Feedback IA)",
      "description": "Generación Swipe 3 versiones, feedback vectorial con pgvector, actualización de borrador, detalle y limpieza de historial",
      "item": [
        {
          "name": "4.1 Generar Batch Swipe (3 Versiones) (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/publications/swipe-batch",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "publications", "swipe-batch"]
            },
            "description": "Genera 3 versiones simultáneas (Experto, Storyteller, Provocador) sobre el commit o tema activo, con tokens, costos e imagen dinámica IA."
          }
        },
        {
          "name": "4.2 Registrar Feedback IA (pgvector) (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"textoGenerado\": \"Optimizar aplicaciones no se logra adivinando, se logra midiendo e implementando persistencia eficiente con Supabase y SQLite...\",\n  \"tema\": \"Gestion-Inventario-APP\",\n  \"puntajeUsuario\": 1,\n  \"estructuraUsada\": \"EXPERT\",\n  \"sourceMode\": \"PROJECT\",\n  \"tokensUsed\": 480,\n  \"costUsd\": 0.00067\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/publications/feedback",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "publications", "feedback"]
            },
            "description": "Registra una acción de swipe (1 = Like, -1 = Dislike, 0 = Borrador) y guarda el embedding vectorial en PostgreSQL pgvector para aprendizaje continuo."
          }
        },
        {
          "name": "4.3 Obtener Previsualización Guardada (GET)",
