  }

  @if (activeSection() === 'quotas') {
  <section class="users-panel quota-panel" aria-labelledby="admin-quota-title">
    <div class="panel-heading">
      <div>
        <h2 id="admin-quota-title">L\xEDmites de solicitudes API</h2>
        <p>Pol\xEDtica global por IP y tipo de ruta, compartida entre instancias mediante PostgreSQL.</p>
      </div>
      @if (quotaPolicy(); as policy) { <span class="quota-updated">Actualizado {{ policy.updatedAt | date:'dd MMM yyyy, HH:mm' }}</span> }
    </div>
    @if (quotaError()) { <div class="message error" role="alert"><span>{{ quotaError() }}</span><button type="button" (click)="loadQuotaPolicy()">Reintentar</button></div> }
    @if (quotaSuccess()) { <p class="quota-success" role="status">{{ quotaSuccess() }}</p> }
    @if (loadingQuotas() && !quotaPolicy()) {
      <p class="loading" role="status">Cargando l\xEDmites\u2026</p>
    } @else if (quotaPolicy()) {
      <form class="quota-form" (ngSubmit)="saveQuotaPolicy()">
        <label>Autenticaci\xF3n
          <span>Solicitudes / minuto \xB7 1\u2013120</span>
          <input type="number" min="1" max="120" required [value]="quotaForm().authRequestsPerMinute" (input)="setQuota('authRequestsPerMinute', $any($event.target).value)" />
        </label>
        <label>Generaci\xF3n de IA
          <span>Solicitudes / minuto \xB7 1\u2013120</span>
          <input type="number" min="1" max="120" required [value]="quotaForm().aiRequestsPerMinute" (input)="setQuota('aiRequestsPerMinute', $any($event.target).value)" />
        </label>
        <label>Resto de la API
          <span>Solicitudes / minuto \xB7 1\u2013600</span>
          <input type="number" min="1" max="600" required [value]="quotaForm().apiRequestsPerMinute" (input)="setQuota('apiRequestsPerMinute', $any($event.target).value)" />
        </label>
        <button type="submit" class="secondary-button" [disabled]="savingQuotas() || loadingQuotas()">{{ savingQuotas() ? 'Guardando\u2026' : 'Guardar l\xEDmites' }}</button>
      </form>
      <p class="quota-note">El bucket se mantiene en PostgreSQL y comparte el l\xEDmite entre instancias. Tras dos minutos sin solicitudes, sus contadores se eliminan. Si PostgreSQL no est\xE1 disponible, AutoPost rechaza la petici\xF3n con un error temporal en lugar de saltarse el l\xEDmite.</p>
    }
  </section>

  <section class="users-panel tenant-quota-panel" aria-labelledby="publication-policy-title">
    <div class="panel-heading">
      <div>
        <h2 id="publication-policy-title">Pol\xEDtica global de aprobaci\xF3n</h2>
        <p>Controla si el pipeline puede publicar autom\xE1ticamente en los espacios.</p>
      </div>
      @if (publicationApprovalPolicy(); as policy) {
        <span class="status" [class.status--inactive]="!policy.approvalRequired"><i></i>{{ policy.approvalRequired ? 'Aprobaci\xF3n obligatoria' : 'Cada espacio elige' }}</span>
      }
    </div>
    @if (publicationPolicyError()) {
      <div class="message error" role="alert"><span>{{ publicationPolicyError() }}</span><button type="button" (click)="loadPublicationPolicy()">Reintentar</button></div>
    }
    @if (publicationPolicySuccess()) { <p class="quota-success" role="status">{{ publicationPolicySuccess() }}</p> }
    @if (loadingPublicationPolicy() && !publicationApprovalPolicy()) {
      <p class="loading" role="status">Cargando pol\xEDtica global\u2026</p>
    } @else if (publicationApprovalPolicy(); as policy) {
      <div class="quota-note">
        <p>{{ policy.approvalRequired ? 'Los espacios conservar\xE1n su preferencia, pero el pipeline dejar\xE1 el contenido en revisi\xF3n y no lo publicar\xE1 autom\xE1ticamente.' : 'Cada espacio puede elegir entre aprobaci\xF3n y publicaci\xF3n autom\xE1tica.' }}</p>
        @if (policy.updatedAt) { <small>Actualizado {{ policy.updatedAt | date:'dd MMM yyyy, HH:mm' }}</small> }
      </div>
      <div class="dialog-actions">
        <button id="publication-policy-toggle" type="button" class="secondary-button" (click)="togglePublicationApprovalPolicy()" [disabled]="savingPublicationPolicy()">
          {{ savingPublicationPolicy() ? 'Guardando\u2026' : policy.approvalRequired ? 'Permitir elecci\xF3n por espacio' : 'Exigir aprobaci\xF3n global' }}
        </button>
      </div>
    }
  </section>

  <section class="users-panel tenant-quota-panel" aria-labelledby="tenant-quota-title">
    <div class="panel-heading">
      <div>
        <h2 id="tenant-quota-title">L\xEDmite de IA por espacio</h2>
        <p>Cada l\xEDmite se comparte en el espacio. Deja el valor vac\xEDo para heredar; a\xF1ade una fecha para crear una excepci\xF3n temporal en tu hora local.</p>
      </div>
    </div>
    @if (tenantAiQuotaError()) {
      <div class="message error quota-inline-error" role="alert"><span>{{ tenantAiQuotaError() }}</span><button type="button" (click)="loadTenantAiQuotas(tenantAiQuotas()?.number || 0)">Reintentar</button></div>
    }
    <div class="table-wrap">
      <table>
        <thead><tr><th scope="col">Espacio de trabajo</th><th scope="col">Cuentas</th><th scope="col">L\xEDmite personalizado y vencimiento</th><th scope="col">L\xEDmite efectivo</th><th scope="col">Acci\xF3n</th></tr></thead>
        <tbody>
          @for (quota of tenantAiQuotas()?.content || []; track quota.tenantId) {
            <tr>
              <td><strong>{{ quota.primaryEmail || 'Sin cuentas' }}</strong><small><code>{{ quota.tenantId }}</code></small></td>
              <td>{{ quota.accountCount }}</td>
              <td>
                <label class="sr-only" [for]="'tenant-quota-' + quota.tenantId">Solicitudes de IA por minuto para {{ quota.primaryEmail || quota.tenantId }}</label>
                <div class="user-quota-control">
                  <input class="tenant-quota-input" [id]="'tenant-quota-' + quota.tenantId" type="number" min="1" max="120" [value]="tenantAiQuotaDrafts()[quota.tenantId] ?? (quota.overrideRequestsPerMinute ?? '')" (input)="setTenantAiQuotaDraft(quota.tenantId, $any($event.target).value)" placeholder="Global" />
                  <label class="sr-only" [for]="'tenant-quota-expiry-' + quota.tenantId">Vencimiento del l\xEDmite para {{ quota.primaryEmail || quota.tenantId }}</label>
                  <input class="tenant-quota-input quota-expiry-input" [id]="'tenant-quota-expiry-' + quota.tenantId" type="datetime-local" [min]="minQuotaExpiry()" [value]="tenantQuotaExpiryValue(quota)" (input)="setTenantAiQuotaExpiryDraft(quota.tenantId, $any($event.target).value)" [attr.aria-describedby]="'tenant-quota-expiry-help-' + quota.tenantId" />
                  <small [id]="'tenant-quota-expiry-help-' + quota.tenantId">{{ quota.overrideRequestsPerMinute === null ? 'Sin excepci\xF3n' : quotaExpiryLabel(quota.overrideExpiresAt) }}</small>
                </div>
              </td>
              <td>{{ quota.effectiveRequestsPerMinute }} solicitudes/min</td>
              <td><button type="button" class="secondary-button" (click)="saveTenantAiQuota(quota)" [disabled]="savingTenantAiQuota() !== null || loadingTenantAiQuotas()">{{ savingTenantAiQuota() === quota.tenantId ? 'Guardando\u2026' : 'Guardar' }}</button></td>
            </tr>
          } @empty {
            @if (!loadingTenantAiQuotas()) { <tr><td class="empty-row" colspan="5">A\xFAn no hay espacios registrados.</td></tr> }
          }
        </tbody>
      </table>
      @if (loadingTenantAiQuotas()) { <p class="table-loading" role="status">Cargando l\xEDmites por espacio\u2026</p> }
    </div>
    @if (tenantAiQuotas(); as page) {
      <footer class="pagination" aria-label="Paginaci\xF3n de l\xEDmites por espacio">
        <span>{{ page.totalElements | number }} espacios \xB7 P\xE1gina {{ page.number + 1 }} de {{ page.totalPages || 1 }}</span>
        <div>
          <button type="button" (click)="loadTenantAiQuotas(page.number - 1)" [disabled]="page.number <= 0 || loadingTenantAiQuotas()">Anterior</button>
          <button type="button" (click)="loadTenantAiQuotas(page.number + 1)" [disabled]="page.number + 1 >= page.totalPages || loadingTenantAiQuotas()">Siguiente</button>
        </div>
      </footer>
    }
  </section>
  }

  @if (activeSection() === 'users') {
  <section class="users-panel" aria-labelledby="admin-users-title">
    <div class="panel-heading">
      <div>
        <h2 id="admin-users-title">Cuentas</h2>
        <p>Gestiona permisos, estado y l\xEDmites personales de IA. Deja el l\xEDmite vac\xEDo para heredar; puedes definir un vencimiento en tu hora local.</p>
      </div>
      <label class="search-field">
        <span class="sr-only">Buscar por nombre o correo</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
        <input type="search" [value]="search()" (input)="onSearch($any($event.target).value)" placeholder="Buscar cuentas\u2026" />
      </label>
    </div>

    @if (usersError()) {
      <div class="message error" role="alert"><span>{{ usersError() }}</span><button type="button" (click)="loadUsers(users()?.number || 0)">Reintentar</button></div>
    }
    @if (rolesSuccess()) { <p class="quota-success" role="status">{{ rolesSuccess() }}</p> }
    @if (userAiQuotaSuccess()) { <p class="quota-success" role="status">{{ userAiQuotaSuccess() }}</p> }
    @if (userAiQuotaError()) { <p class="message error quota-inline-error" role="alert">{{ userAiQuotaError() }}</p> }
    <div class="table-wrap">
      <table>
        <thead><tr><th scope="col">Usuario</th><th scope="col">Espacio</th><th scope="col">Rol</th><th scope="col">Estado</th><th scope="col">IA / min</th><th scope="col">Registro</th><th scope="col">Acciones</th></tr></thead>
        <tbody>
          @for (user of users()?.content || []; track user.id) {
            <tr>
              <td><strong>{{ user.name }}</strong><small>{{ user.email }}</small></td>
              <td><code>{{ user.tenantId.slice(0, 8) }}</code></td>
              <td><div class="role-list">@for (role of user.roles; track role) { <span>{{ formatRole(role) }}</span> }</div></td>
              <td><span class="status" [class.status--inactive]="!user.active"><i></i>{{ user.active ? 'Activa' : 'Inactiva' }}</span></td>
              <td><div class="user-quota-control"><label class="sr-only" [attr.for]="'user-ai-quota-' + user.id">L\xEDmite personal de IA para {{ user.email }} por minuto</label><input class="tenant-quota-input" type="number" min="1" max="120" [id]="'user-ai-quota-' + user.id" [value]="userAiQuotaDrafts()[user.id] ?? (user.aiRequestsPerMinute ?? '')" (input)="setUserAiQuotaDraft(user.id, $any($event.target).value)" placeholder="Heredar" /><label class="sr-only" [for]="'user-ai-quota-expiry-' + user.id">Vencimiento del l\xEDmite personal para {{ user.email }}</label><input class="tenant-quota-input quota-expiry-input" type="datetime-local" [id]="'user-ai-quota-expiry-' + user.id" [min]="minQuotaExpiry()" [value]="userQuotaExpiryValue(user)" (input)="setUserAiQuotaExpiryDraft(user.id, $any($event.target).value)" /><small>Efectivo: {{ user.effectiveAiRequestsPerMinute }}/min \xB7 {{ user.aiRequestsPerMinute === null ? 'Heredado' : quotaExpiryLabel(user.aiRequestsPerMinuteExpiresAt) }}</small><button type="button" class="secondary-button" (click)="saveUserAiQuota(user)" [disabled]="savingUserAiQuota() !== null">{{ savingUserAiQuota() === user.id ? 'Guardando\u2026' : 'Guardar' }}</button></div></td>
              <td>{{ user.createdAt | date:'dd MMM yyyy' }}</td>
              <td><div class="account-actions"><button type="button" class="secondary-button" (click)="requestRoleChange(user)">Permisos</button><button type="button" class="account-action" [class.account-action--enable]="!user.active" (click)="requestStatusChange(user)">{{ user.active ? 'Suspender' : 'Reactivar' }}</button></div></td>
            </tr>
          } @empty {
            @if (!loadingUsers()) { <tr><td class="empty-row" colspan="7">No hay cuentas que coincidan con la b\xFAsqueda.</td></tr> }
          }
        </tbody>
      </table>
      @if (loadingUsers()) { <p class="table-loading" role="status">Actualizando lista\u2026</p> }
    </div>
    @if (users(); as page) {
      <footer class="pagination">
        <span>{{ page.totalElements | number }} cuentas \xB7 P\xE1gina {{ page.number + 1 }} de {{ page.totalPages || 1 }}</span>
        <div>
          <button type="button" (click)="loadUsers(page.number - 1)" [disabled]="page.number <= 0 || loadingUsers()">Anterior</button>
          <button type="button" (click)="loadUsers(page.number + 1)" [disabled]="page.number + 1 >= page.totalPages || loadingUsers()">Siguiente</button>
        </div>
      </footer>
    }
  </section>
  }

  @if (activeSection() === 'audit') {
  <section class="users-panel" aria-labelledby="admin-audit-title">
    <div class="panel-heading">
      <div>
        <h2 id="admin-audit-title">Auditor\xEDa del sistema</h2>
        <p>Eventos recientes de cuentas y operaciones registradas.</p>
      </div>
      <button type="button" class="secondary-button" (click)="loadAudit()" [disabled]="loadingAudit()">{{ loadingAudit() ? 'Actualizando\u2026' : 'Actualizar' }}</button>
    </div>
    @if (auditError()) {
      <div class="message error" role="alert"><span>{{ auditError() }}</span><button type="button" (click)="loadAudit()">Reintentar</button></div>
    }
    <div class="table-wrap">
      <table>
        <thead><tr><th scope="col">Acci\xF3n</th><th scope="col">Actor</th><th scope="col">Espacio</th><th scope="col">Fecha</th></tr></thead>
        <tbody>
          @for (event of auditEvents()?.content || []; track event.id) {
            <tr><td><strong>{{ event.action }}</strong></td><td>{{ event.actor }}</td><td><code>{{ event.tenantId.slice(0, 8) }}</code></td><td>{{ event.createdAt | date:'dd MMM yyyy, HH:mm' }}</td></tr>
          } @empty {
            @if (!loadingAudit()) { <tr><td class="empty-row" colspan="4">A\xFAn no hay eventos registrados.</td></tr> }
          }
        </tbody>
      </table>
      @if (loadingAudit()) { <p class="table-loading" role="status">Cargando auditor\xEDa\u2026</p> }
    </div>
    @if (auditEvents(); as page) {
      <footer class="pagination" aria-label="Paginaci\xF3n de auditor\xEDa">
        <span>{{ page.totalElements | number }} eventos \xB7 P\xE1gina {{ page.number + 1 }} de {{ page.totalPages || 1 }}</span>
        <div>
          <button type="button" (click)="loadAudit(page.number - 1)" [disabled]="page.number <= 0 || loadingAudit()">Anterior</button>
          <button type="button" (click)="loadAudit(page.number + 1)" [disabled]="page.number + 1 >= page.totalPages || loadingAudit()">Siguiente</button>
        </div>
      </footer>
    }
  </section>
  }

  @if (pendingStatus(); as pending) {
    <app-dialog [title]="pending.active ? 'Reactivar cuenta' : 'Suspender cuenta'" (closed)="pendingStatus.set(null)">
      <p>La cuenta <strong>{{ pending.user.email }}</strong> {{ pending.active ? 'recuperar\xE1 acceso a AutoPost.' : 'perder\xE1 acceso a AutoPost.' }} Sus datos no se eliminar\xE1n y se podr\xE1 reactivar despu\xE9s.</p>
      @if (statusError()) { <p class="message error" role="alert">{{ statusError() }}</p> }
      <div class="dialog-actions">
        <button type="button" class="secondary-button" (click)="pendingStatus.set(null)" [disabled]="savingStatus()">Cancelar</button>
        <button type="button" class="account-action" [class.account-action--enable]="pending.active" (click)="confirmStatusChange()" [disabled]="savingStatus()">{{ savingStatus() ? 'Guardando\u2026' : pending.active ? 'Reactivar cuenta' : 'Suspender cuenta' }}</button>
      </div>
    </app-dialog>
  }
  @if (pendingRoles(); as pending) {
    <app-dialog title="Permisos de la cuenta" (closed)="pendingRoles.set(null)">
      <p>Selecciona los roles para <strong>{{ pending.user.email }}</strong>. Al guardar, se cerrar\xE1n sus sesiones activas.</p>
      <fieldset class="role-options" [disabled]="savingRoles()">
        <legend>Roles disponibles</legend>
        <label><input type="checkbox" [checked]="pending.roles.has('ROLE_USER')" (change)="toggleRole('ROLE_USER', $any($event.target).checked)" /> Usuario</label>
        <label><input type="checkbox" [checked]="pending.roles.has('ROLE_DESARROLLADOR')" (change)="toggleRole('ROLE_DESARROLLADOR', $any($event.target).checked)" /> Desarrollador</label>
        <label><input type="checkbox" [checked]="pending.roles.has('ROLE_ADMIN')" (change)="toggleRole('ROLE_ADMIN', $any($event.target).checked)" /> Administrador</label>
      </fieldset>
      @if (!pending.roles.size) { <p class="message error" role="alert">La cuenta debe conservar al menos un rol.</p> }
      @if (rolesError()) { <p class="message error" role="alert">{{ rolesError() }}</p> }
      <div class="dialog-actions">
        <button type="button" class="secondary-button" (click)="pendingRoles.set(null)" [disabled]="savingRoles()">Cancelar</button>
        <button type="button" class="account-action account-action--enable" (click)="confirmRoleChange()" [disabled]="savingRoles() || !pending.roles.size">{{ savingRoles() ? 'Guardando\u2026' : 'Guardar permisos' }}</button>
      </div>
    </app-dialog>
  }
</div>
