      @if (loadingInvitations()) { <p class="table-loading" role="status">Cargando invitaciones\u2026</p> }
    </div>
    @if (invitations(); as page) {
      <footer class="pagination" aria-label="Paginaci\xF3n de invitaciones">
        <span>{{ page.totalElements | number }} invitaciones \xB7 P\xE1gina {{ page.number + 1 }} de {{ page.totalPages || 1 }}</span>
        <div>
          <button type="button" (click)="loadInvitations(page.number - 1)" [disabled]="page.number <= 0 || loadingInvitations()">Anterior</button>
