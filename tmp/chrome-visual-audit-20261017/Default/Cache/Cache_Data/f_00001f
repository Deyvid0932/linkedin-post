@layer base {
  :root {
    --bg-main: #f6f7f8;
    --bg-card: #ffffff;
    --border-card: #e5e6e8;
    --text-primary: #202124;
    --text-secondary: #70757d;
    --bg-sidebar: #ffffff;
    --border-sidebar: #e5e6e8;
    --glass-bg: rgba(255, 255, 255, 0.85);
    --glass-border: rgba(226, 232, 240, 0.8);
  }
  html.dark,
  :root.dark,
  body.dark,
  [data-theme=dark] {
    --bg-main: #0b1020;
    --bg-card: #151c2f;
    --border-card: #29344b;
    --text-primary: #f3f6ff;
    --text-secondary: #a8b3ca;
    --bg-sidebar: #080d1a;
    --border-sidebar: #202b41;
    --glass-bg: rgba(21, 28, 47, 0.96);
    --glass-border: rgba(170, 190, 225, 0.13);
  }
  html,
  body {
    height: 100%;
    margin: 0;
    font-family:
      "Outfit",
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
    transition: background-color 0.3s ease, color 0.3s ease;
  }
  body {
    background-color: var(--bg-main);
    color: var(--text-primary);
  }
}
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(6px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.animate-fadeIn {
  animation: fadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
:root {
  --accent: #c93640;
  --accent-text: #a92732;
  --focus: #c93640;
  --status-success: #047857;
  --status-warning: #92400e;
  --status-error: #be123c;
}
.dark {
  --status-success: #6ee7b7;
  --status-warning: #fcd34d;
  --status-error: #fda4af;
}
.dark .text-indigo-500,
.dark .text-indigo-600,
.dark .text-indigo-700,
.dark [class~="hover:text-indigo-900"]:hover {
  color: var(--accent-text);
}
.ui-page {
  width: 100%;
  max-width: 1440px;
  margin-inline: auto;
  display: grid;
  gap: 24px;
  font-size: 15px;
  line-height: 1.6;
}
.ui-page--form {
  max-width: 800px;
}
.ui-page--editor {
  max-width: 1280px;
}
.ui-heading {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}
.ui-title {
  font-size: 32px;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: -.035em;
}
.ui-section-title {
  font-size: 22px;
  line-height: 1.3;
  font-weight: 600;
  letter-spacing: -.02em;
}
.ui-muted {
  color: var(--text-secondary);
}
.ui-meta {
  font-size: 13px;
  color: var(--text-secondary);
}
.ui-card,
.connection-card {
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  border-radius: 12px;
  padding: 24px;
  box-shadow: none;
}
.ui-toolbar,
.ui-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: center;
}
.ui-field {
  display: grid;
  gap: 6px;
}
.ui-field > label {
  font-weight: 600;
}
.ui-input {
  width: 100%;
  min-height: 44px;
  padding: 10px 12px;
  border: 1px solid var(--border-card);
  border-radius: 8px;
  background: var(--bg-card);
  color: var(--text-primary);
  font: inherit;
}
.publishing-config-form > .ui-field > label {
  display: flex;
  height: 24px;
  min-height: 24px;
  align-items: center;
  line-height: 24px;
}
.publishing-config-form > .ui-field > input.ui-input,
.publishing-config-form > .ui-field > select.ui-input {
  box-sizing: border-box;
  height: 46px;
}
.ui-button {
  min-height: 44px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 16px;
  border: 1px solid var(--border-card);
  border-radius: 8px;
  background: var(--bg-card);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
}
.ui-button:hover {
  background: var(--bg-main);
}
.ui-button--primary {
  color: white;
  background: var(--accent);
  border-color: var(--accent);
}
.ui-button--primary:hover {
  background: var(--color-indigo-800);
}
.ui-button:disabled {
  opacity: .55;
  cursor: not-allowed;
}
.ui-button[aria-pressed=true] {
  border-color: var(--accent);
  color: var(--accent-text);
  background: var(--accent);
}
@supports (color: color-mix(in lab, red, red)) {
  .ui-button[aria-pressed=true] {
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-card));
  }
}
.ui-alert {
  border: 1px solid var(--border-card);
  border-left: 3px solid var(--status-error);
  border-radius: 8px;
  padding: 16px;
}
.ui-alert--success {
  border-left-color: var(--status-success);
}
.account-filter-selected {
  background: var(--accent);
  color: var(--accent-text);
}
@supports (color: color-mix(in lab, red, red)) {
  .account-filter-selected {
    background: color-mix(in srgb, var(--accent) 10%, var(--bg-card));
  }
}
.mobile-nav-active {
  color: var(--accent-text);
}
.ui-status {
  display: inline-flex;
  padding: 3px 10px;
  border-radius: 6px;
  background: var(--bg-main);
  font-size: 13px;
  font-weight: 500;
}
.ui-status--success {
  color: var(--status-success);
}
.ui-status--error {
  color: var(--status-error);
}
.ui-empty {
  padding: 24px;
  text-align: center;
  color: var(--text-secondary);
}
.ui-row {
  width: 100%;
  display: flex;
  text-align: left;
  align-items: center;
  gap: 16px;
  padding: 20px 0;
  border-bottom: 1px solid var(--border-card);
  cursor: pointer;
}
.ui-row:hover {
  background: var(--bg-main);
}
.ui-excerpt {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  color: var(--text-secondary);
}
.ui-dialog {
  margin: auto;
  width: min(560px, calc(100vw - 32px));
  max-height: calc(100dvh - 32px);
  border: 1px solid var(--border-card);
  border-radius: 12px;
  background: var(--bg-card);
  color: var(--text-primary);
  padding: 0;
}
.ui-dialog::backdrop {
  background: rgb(15 23 42 / .45);
}
.ui-drawer {
  margin: 0 0 0 auto;
  height: 100dvh;
  max-height: 100dvh;
  width: min(620px, 100vw);
  border-radius: 0;
}
.ui-dialog-heading {
  padding: 20px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  border-bottom: 1px solid var(--border-card);
}
.ui-dialog-heading h2 {
  font-size: 22px;
  font-weight: 600;
}
.ui-dialog-body {
  padding: 24px;
  display: grid;
  gap: 20px;
}
.ui-fulltext {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  line-height: 1.75;
}
.ui-week {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  border: 1px solid var(--border-card);
  border-radius: 8px;
  overflow: hidden;
}
.ui-day {
  min-height: 130px;
  padding: 12px;
  border-right: 1px solid var(--border-card);
}
.ui-slot {
  margin-top: 10px;
  padding: 6px;
  border-radius: 6px;
  background: var(--accent);
  font-size: 13px;
}
@supports (color: color-mix(in lab, red, red)) {
  .ui-slot {
    background: color-mix(in srgb, var(--accent) 10%, var(--bg-card));
  }
}
@media (max-width: 639px) {
  .ui-title {
    font-size: 28px;
  }
  .ui-card,
  .connection-card {
    padding: 16px;
  }
  .ui-row {
    flex-wrap: wrap;
  }
  .ui-week {
    grid-template-columns: 1fr;
  }
  .ui-day {
    min-height: auto;
    border-bottom: 1px solid var(--border-card);
  }
}
:focus-visible {
  outline: 3px solid var(--focus);
  outline-offset: 3px;
}
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
    scroll-behavior: auto !important;
  }
}
.app-frame {
  background: var(--bg-main);
  color: var(--text-primary);
}
.app-sidebar {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 240px;
  height: 100dvh;
  overflow: visible;
  border-right: 1px solid var(--border-sidebar);
  background: var(--bg-sidebar);
  color: var(--text-primary);
}
.app-brand {
  min-height: 64px;
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 18px;
  border-bottom: 1px solid var(--border-sidebar);
  text-decoration: none;
  color: inherit;
}
.app-brand-mark {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: var(--accent);
  color: white;
  font-size: 18px;
  font-weight: 700;
}
.app-brand strong {
  display: block;
  font-size: 15px;
  line-height: 1.2;
}
.app-brand small {
  display: block;
  margin-top: 3px;
  color: var(--text-secondary);
  font-size: 12px;
}
.app-mode-switch {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 3px;
  margin: 12px 14px 2px;
  padding: 4px;
  border: 1px solid var(--border-card);
  border-radius: 9px;
  background: var(--bg-main);
}
.app-mode-switch a {
  min-height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8px;
  border-radius: 6px;
  color: var(--text-secondary);
  font-size: 12px;
  font-weight: 600;
  text-align: center;
  text-decoration: none;
  transition: background-color .15s ease, color .15s ease;
}
.app-mode-switch a:hover {
  color: var(--text-primary);
  background: var(--text-primary);
}
@supports (color: color-mix(in lab, red, red)) {
  .app-mode-switch a:hover {
    background: color-mix(in srgb, var(--text-primary) 5%, transparent);
  }
}
.app-mode-switch a.app-mode-option--active {
  background: var(--bg-card);
  color: var(--accent-text);
  box-shadow: 0 1px 2px rgb(0 0 0 / .08);
}
.app-mode-switch a:focus-visible {
  outline: 3px solid var(--focus);
  outline-offset: 2px;
}
.app-new-post {
  min-height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin: 14px 14px 10px;
  border: 1px solid var(--accent);
  border-radius: 9px;
  background: var(--accent);
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  transition: filter .15s ease, transform .15s ease;
}
.app-new-post svg {
  width: 17px;
  height: 17px;
}
.app-new-post:hover {
  filter: brightness(1.08);
  transform: translateY(-1px);
}
.app-nav {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 4px 12px 14px;
}
.app-nav-group {
  margin: 13px 0 19px;
}
.app-nav-group h2 {
  margin: 0 10px 7px;
  color: var(--text-secondary);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
}
.app-nav-links {
  display: grid;
  gap: 2px;
}
.app-nav-link {
  min-height: 38px;
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 10px;
  border-radius: 8px;
  color: var(--text-primary);
  font-size: 13px;
  font-weight: 500;
  text-decoration: none;
  transition: background-color .15s ease, color .15s ease;
}
.app-nav-link svg {
  flex: 0 0 18px;
  color: var(--text-secondary);
}
.app-nav-link:hover {
  background: var(--text-primary);
}
@supports (color: color-mix(in lab, red, red)) {
  .app-nav-link:hover {
    background: color-mix(in srgb, var(--text-primary) 6%, transparent);
  }
}
.app-nav-link--active {
  background: var(--accent);
  color: var(--accent-text);
  font-weight: 650;
}
@supports (color: color-mix(in lab, red, red)) {
  .app-nav-link--active {
    background: color-mix(in srgb, var(--accent) 11%, var(--bg-card));
  }
}
.app-nav-link--active svg {
  color: var(--accent-text);
}
.app-sidebar-footer {
  position: relative;
  display: grid;
  gap: 8px;
  padding: 10px 12px 12px;
  border-top: 1px solid var(--border-sidebar);
